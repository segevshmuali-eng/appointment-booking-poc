      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "meshulam-ipn-webhook-id"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// בדיקה האם העסקה ממשולם אושרה (status === 1 או '1')\nconst isApproved = String(body.status) === '1' || String(body.status) === 'APPROVED';\nconst transactionId = body.transactionId || body.asmachta || body.transactionCode || 'TRX_' + Date.now();\nconst phone = (body.phone || body.custom_fields || body.cField1 || '').trim();\nconst email = body.email || '';\nconst amount = Number(body.sum || body.amount || 0);\n\nreturn [{\n  json: {\n    isApproved,\n    transactionId,\n    phone,\n    email,\n    amount,\n    paymentMethod: body.paymentType || (body.bit ? 'BIT' : 'CREDIT_CARD'),\n    rawBody: body\n  }\n}];"
      },
      "id": "parse-meshulam-ipn",
      "name": "ניתוח נתוני עסקת משולם",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isApproved }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-approved",
      "name": "האם התשלום אושר במשולם?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
