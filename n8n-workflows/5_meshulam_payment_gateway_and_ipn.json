        "jsonBody": "={\n  \"pageCode\": \"הזן_כאן_את_קוד_הדף_PAGE_CODE\",\n  \"userId\": \"הזן_כאן_את_מזהה_המשתמש_USER_ID\",\n  \"apiKey\": \"הזן_כאן_את_מפתח_ה-API_של_משולם\",\n  \"token\": \"{{ $json.body.cardToken }}\",\n  \"sum\": {{ $json.body.servicePrice || 320 }},\n  \"fullName\": \"{{ $json.body.fullName }}\",\n  \"phone\": \"{{ $json.body.phone }}\",\n  \"email\": \"{{ $json.body.email }}\",\n  \"description\": \"חיוב תור מרחב שלווה - {{ $json.body.serviceName }}\"\n}"
      },
